# PragatiAI Environment Variables Example
# Duplicate this file to .env and fill in your configuration.
# NEVER commit real API keys or secrets to Git.

# Server Configuration
PORT=5000

# External AI Provider Configuration
# Supported providers: 'gemini' | 'openai' | 'groq' | 'custom'
AI_PROVIDER=gemini

# Server-side External AI API Key (never exposed to browser or frontend)
AI_API_KEY=your_ai_api_key_here

# Model Identifier (e.g. gemini-2.5-flash, gpt-4o-mini, llama-3.3-70b-versatile)
AI_MODEL=gemini-2.5-flash

# Optional Custom Base URL (if using private proxy, Groq, Ollama, or OpenRouter)
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Frontend Configuration (Used at build/runtime by Vite if backend is hosted on a separate URL)
# VITE_API_BASE_URL=http://127.0.0.1:5000/api
